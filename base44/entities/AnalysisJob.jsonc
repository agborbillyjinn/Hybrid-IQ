{
  "name": "AnalysisJob",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "researching_company",
        "searching_erp_evidence",
        "building_erp_history",
        "detecting_signals",
        "calculating_complexity",
        "modelling_cost",
        "mapping_committee",
        "creating_gtm",
        "searching_erp_vacancies",
        "analysing_hiring_signals",
        "inferring_programme_stage",
        "estimating_consulting_demand",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_sources": {
      "type": "string"
    },
    "analysis_version": {
      "type": "string"
    },
    "intelligence": {
      "type": "object"
    },
    "source_provider": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_url": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "research_mode": {
      "type": "string",
      "enum": [
        "MOCK",
        "LIVE",
        "HYBRID"
      ]
    },
    "research_metadata": {
      "type": "object"
    }
  },
  "required": [
    "analysis_id",
    "company_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}