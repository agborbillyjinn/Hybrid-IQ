{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "finding": {
      "type": "string"
    },
    "erp": {
      "type": "string"
    },
    "erp_vendor": {
      "type": "string"
    },
    "erp_product": {
      "type": "string"
    },
    "erp_version": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "evidence_date": {
      "type": "string",
      "format": "date"
    },
    "date_found": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "evidence_extract": {
      "type": "string"
    },
    "evidence_summary": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "HIGHLY LIKELY",
        "INFERRED",
        "UNKNOWN"
      ],
      "default": "INFERRED"
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "HIGHLY LIKELY",
        "INFERRED",
        "UNKNOWN"
      ],
      "default": "INFERRED"
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "PRIMARY",
        "STRONG",
        "SUPPORTING",
        "WEAK"
      ],
      "default": "SUPPORTING"
    },
    "confidence_score": {
      "type": "number"
    },
    "current_or_historical": {
      "type": "string",
      "enum": [
        "CURRENT",
        "HISTORICAL"
      ],
      "default": "CURRENT"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified": {
      "type": "string",
      "format": "date-time"
    },
    "supported_fields": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "finding"
  ]
}