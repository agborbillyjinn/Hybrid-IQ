{
  "name": "IntegrationConfig",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "webhook_url": {
      "type": "string"
    },
    "base_url": {
      "type": "string"
    },
    "api_key": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}